PORT=3001
DATA_SOURCE=mock
SWIGGY_BASE_URL=https://www.swiggy.com/dapi
REDIS_URL=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Postgres for auth (postgresql:// only — do not repeat DATABASE_URL= in the value).
# URL-encode special characters in the password (e.g. ! → %21).
# Compose `api` service uses host `postgres`; from the host machine use `localhost`.
DATABASE_URL=postgresql://nomnom:nomnom@localhost:5432/nomnom?schema=public
# Seeded admin login (npx prisma db seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
# Live testing: skip Nest cache (1 / true / yes)
CACHE_DISABLED=true
